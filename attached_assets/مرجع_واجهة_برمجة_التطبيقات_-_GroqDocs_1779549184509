a.neum, button.neum { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; position: relative; border-radius: 50px; color: var(--neum-text-color); background: linear-gradient(to bottom,var(--neum-bg-n),var(--neum-bg-c),var(--neum-bg-s)); cursor: pointer; text-decoration: none; transition: box-shadow 0.3s; text-shadow: 0 1px 0 var(--neum-text-shadow); }

